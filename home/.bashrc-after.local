alias me='devemacs -nw'

alias e=smart-editor
alias v=smart-editor
alias vim=smart-editor
alias emacs=smart-editor

is-emacs-server-running() {
  local result
  result=$(emacsclient -e "(+ 1 1)" 2>/dev/null)
  [[ $result = 2 ]] && return 0
  return 1
}

smart-editor() {
  if type -P emacs &>/dev/null \
    && is-emacs-server-running; then
    emacs-edit "$@"
  elif type -P devemacs &>/dev/null; then
    devemacs -nw "$@"
  else
    vim "$@"
  fi
}

# alias vim=smart-editor

alias bf="batchfetch"

if ! type -P so &>/dev/null; then
  so() {
    "$@" || return "$?"
  }
fi

alias emacs-batch="emacs --batch --init-directory=~/.emacs-use-package.d/ -l ~/.emacs-use-package.d/early-init.el -l ~/.emacs-use-package.d/init.el"

