<?xml version="1.0"?>
<ruleset name="PEARWithExactIndentation">
    <description>PEAR with exact four-space scope indentation.</description>

    <rule ref="PEAR"/>

    <rule ref="PEAR.WhiteSpace.ScopeIndent">
        <properties>
            <property name="indent" value="4"/>
            <property name="exact" value="true"/>
            <property name="tabIndent" value="false"/>
        </properties>
    </rule>
</ruleset>
