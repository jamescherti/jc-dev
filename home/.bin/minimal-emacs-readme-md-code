"""Extract Emacs Lisp code blocks from a Markdown file to create an .el file."""

import re
import sys
from pathlib import Path


def extract_code_blocks(content: str, keywords: list[str]) -> list[str]:
    """Extract code blocks from Markdown content that contain any of the keywords.

    Args:
        content: The Markdown text to parse.
        keywords: A list of substring keywords to search for inside the code blocks.

    Returns:
        A list of extracted code block strings matching the criteria.
    """
    # Replace non-breaking spaces (U+00A0) with standard spaces
    content = content.replace("\xa0", " ")

    # Match markdown code blocks flexibly, allowing spaces before/after the language name
    pattern = re.compile(r"```[ \t]*[a-zA-Z-]*[ \t]*\n(.*?)```", re.DOTALL)
    matches = pattern.findall(content)

    extracted_blocks: list[str] = []
    for block in matches:
        if any(keyword in block for keyword in keywords):
            extracted_blocks.append(block.strip())

    return extracted_blocks


def main() -> None:
    """Execute the main entry point of the script."""
    if len(sys.argv) < 2:
        print(";; Usage: python3 extract_elisp.py <path_to_markdown_file>", file=sys.stderr)
        sys.exit(1)

    file_path = Path(sys.argv[1])

    if not file_path.is_file():
        print(f";; Error: The path '{file_path}' is not a valid file.", file=sys.stderr)
        sys.exit(1)

    try:
        content = file_path.read_text(encoding="utf-8")
    except OSError as e:
        print(f";; Error reading file {file_path}: {e}", file=sys.stderr)
        sys.exit(1)

    keywords = ["use-package", "setq"]
    matched_blocks = extract_code_blocks(content, keywords)

    # Output pure Elisp code directly to stdout
    for block in matched_blocks:
        print(block)
        print()


if __name__ == "__main__":
    main()
