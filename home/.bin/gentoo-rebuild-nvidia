set -euo pipefail

if [[ "${EUID}" -ne 0 ]]; then
  echo "This script must be run as root." >&2
  exit 1
fi

# Save the current active kernel symlink to restore it upon completion
current_kernel=$(readlink /usr/src/linux || echo "")

cd /usr/src
for kernel_dir in linux-*/; do
  # Remove trailing slash from the directory name
  kernel_name="${kernel_dir%/}"

  # Skip if it is not a directory or globbing fails
  [[ -d "${kernel_name}" ]] || continue

  # Extract the version string expected by dracut (e.g., 7.2.5-gentoo-dist)
  kver="${kernel_name#linux-}"

  echo "============================================================"
  echo "Processing kernel: ${kver}"
  echo "============================================================"

  # Point Portage to the target kernel headers
  eselect kernel set "${kernel_name}"

  # Rebuild all out-of-tree modules for this specific kernel
  emerge -v1 @module-rebuild

  # Bake the newly compiled drivers into the initramfs
  dracut --kver "${kver}" --force
done

# Restore the original system symlink
if [[ -n "${current_kernel}" ]]; then
  echo "Restoring original kernel symlink: ${current_kernel}"
  eselect kernel set "${current_kernel#/usr/src/}"
fi

echo "Module rebuild and initramfs generation complete."
