"""
Script to generate a GitHub release from an existing git tag.

Authentication:
---------------
This script requires a GitHub Personal Access Token (PAT) with repository write access.
The token is loaded using the following priority:

1. A GPG-encrypted YAML file located at ~/.secrets/github.yaml.asc containing:
   token: your_personal_access_token_here
2. The GITHUB_TOKEN environment variable:
   export GITHUB_TOKEN="your_personal_access_token_here"

Tokens
------
Token generation options (GitHub > Settings > Developer settings > Personal access
tokens):

Option 1: Fine-grained token (recommended for targeted repo access)
  1. Select 'Fine-grained tokens' and click 'Generate new token'.
  2. Under 'Repository access', select 'Only select repositories' and pick the repo.
  3. Expand 'Repository permissions' and set 'Contents' to 'Read and write'.
  4. Generate and copy the token.

Option 2: Classic token (for public repositories only)
  1. Select 'Tokens (classic)' and click 'Generate new token (classic)'.
  2. Under 'Select scopes', check only 'public_repo'.
  3. Leave the parent 'repo' scope and all other scopes unchecked.
  4. Generate and copy the token.

Token configuration:
Encrypt your YAML token file into ~/.secrets/github.yaml.asc, for example:
    gpg --symmetric --armor ~/.secrets/github.yaml

Or export it in your shell environment:
    export GITHUB_TOKEN="your_token_here"
"""

import os
import subprocess
import sys
from pathlib import Path

import yaml
from github import Auth
from github import Github
from github.GithubException import GithubException


def get_github_token() -> str:
    """
    Retrieve the GitHub Personal Access Token.

    Checks ~/.secrets/github.yaml.asc first, decrypts it using GPG, then falls
    back to the GITHUB_TOKEN environment variable.

    Returns:
        The GitHub token string.

    Raises:
        ValueError: If the token cannot be found in either location.
    """
    token = os.environ.get("GITHUB_TOKEN")
    if token:
        return token

    secrets_file = Path.home() / ".secrets" / "github.yaml.asc"

    if secrets_file.is_file():
        try:
            result = subprocess.run(
                ["gpg", "--decrypt", "--quiet", "--batch", str(secrets_file)],
                capture_output=True,
                text=True,
                check=True,
            )
            secrets = yaml.safe_load(result.stdout)
            if secrets and isinstance(secrets, dict) and "token" in secrets:
                return str(secrets["token"])
        except subprocess.CalledProcessError as e:
            print(f"Failed to decrypt {secrets_file}: {e.stderr}")
            sys.exit(1)
        except yaml.YAMLError as e:
            print(f"Failed to parse decrypted content of {secrets_file}: {e}")
            sys.exit(1)

    raise ValueError(
        "GitHub token not found. Please provide it via ~/.secrets/github.yaml.asc "
        "or the GITHUB_TOKEN environment variable."
    )


def get_github_repo_name() -> str:
    """
    Parse the GitHub repository identifier (owner/repo) from the origin remote URL.

    Returns:
        The parsed repository string.

    Raises:
        ValueError: If the remote URL does not match standard GitHub formats.
    """
    result = subprocess.run(
        ["git", "remote", "get-url", "origin"],
        capture_output=True,
        text=True,
        check=True,
    )
    url = result.stdout.strip()
    if url.endswith(".git"):
        url = url[:-4]

    if "github.com:" in url:
        return url.split("github.com:")[1]
    if "github.com/" in url:
        return url.split("github.com/")[1]

    raise ValueError(f"Could not parse GitHub repository from URL: {url}")


def create_github_release(repo_name: str, tag_name: str, token: str) -> None:
    """
    Create a GitHub release for the given tag using the PyGithub library.

    Args:
        repo_name: The GitHub repository identifier (e.g., owner/repo).
        tag_name: The tag name for the release.
        token: The GitHub Personal Access Token.
    """
    print(f"Creating GitHub release for {repo_name} via API...")
    auth = Auth.Token(token)
    gh = Github(auth=auth)
    repo = gh.get_repo(repo_name)

    repo.create_git_release(
        tag=tag_name,
        name=tag_name,
        message="",
        generate_release_notes=True,
    )
    print("Release created.")


def main() -> None:
    """Run the main CLI logic."""
    if len(sys.argv) != 2:
        print(f"Usage: {sys.argv[0]} <tag-name>")
        sys.exit(1)

    tag_name = sys.argv[1]

    try:
        token = get_github_token()
        repo_name = get_github_repo_name()
        create_github_release(repo_name, tag_name, token)
    except ValueError as e:
        print(f"Configuration error: {e}")
        sys.exit(1)
    except subprocess.CalledProcessError as e:
        print(f"Git command failed: {e}")
        sys.exit(1)
    except GithubException as e:
        print(f"GitHub API error: {e}")
        sys.exit(1)
    except Exception as e:
        print(f"Error: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
