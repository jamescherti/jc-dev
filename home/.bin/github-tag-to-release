"""
Script to generate a GitHub release from an existing git tag.

Authentication:
---------------
This script requires a GitHub Personal Access Token (PAT) with repository write access.
The token is loaded using the following priority:

1. A GPG-encrypted YAML file located at /path/to/github-token.yaml.asc containing:

   token: your_personal_access_token_here
2. The GITHUB_TOKEN environment variable:
   export GITHUB_TOKEN="your_personal_access_token_here"

Tokens
------
Token generation options (GitHub > Settings > Developer settings > Personal access
tokens):

Option 1: Fine-grained token (recommended for targeted repo access)
  1. Select 'Fine-grained tokens' and click 'Generate new token'.
  2. Under 'Repository access', select 'Only select repositories' and pick the repo.
  3. Expand 'Repository permissions' and set 'Contents' to 'Read and write'.
  4. Generate and copy the token.

Option 2: Classic token (for public repositories only)
  1. Select 'Tokens (classic)' and click 'Generate new token (classic)'.
  2. Under 'Select scopes', check only 'public_repo'.
  3. Leave the parent 'repo' scope and all other scopes unchecked.
  4. Generate and copy the token.

Token configuration:
Encrypt your YAML token file into /path/to/github-token.yaml.asc, for example:
    gpg --symmetric --armor /path/to/github-token.yaml

Or export it in your shell environment:
    export GITHUB_TOKEN="your_token_here"
"""

import re
import sys
from collections.abc import Iterable

from github_lib import GitHubLib, handle_github_errors

try:
    from packaging.version import InvalidVersion, Version
except ImportError:
    Version = None  # type: ignore[assignment,misc]
    InvalidVersion = Exception  # type: ignore[assignment,misc]

VERSION_TAG_RE = re.compile(r"^[^0-9]*(\d+(?:\.\d+)+.*)$")


def parse_version_key(tag: str) -> tuple[int, ...] | Version | None:
    """Extract a sortable version key from a tag string."""
    match = VERSION_TAG_RE.match(tag)
    if not match:
        return None

    version_str = match.group(1)
    if Version is not None:
        try:
            return Version(version_str)
        except InvalidVersion:
            pass

    # Fallback to numeric tuple extraction if packaging is unavailable or non-PEP 440
    numbers = re.findall(r"\d+", version_str)
    if not numbers:
        return None
    return tuple(int(n) for n in numbers)


def sort_versions(items: Iterable[str]) -> list[str]:
    """Sort an iterable of version strings from oldest to newest.

    Args:
        items: An iterable of strings containing version representations.

    Returns:
        A list of version strings sorted in ascending order.
    """
    versioned_items: list[tuple[tuple[int, ...] | Version, str]] = []
    for raw_item in items:
        item = raw_item.strip()
        if not item:
            continue

        version_key = parse_version_key(item)
        if version_key is not None:
            versioned_items.append((version_key, item))

    versioned_items.sort(key=lambda entry: entry[0])
    return [item for _, item in versioned_items]


@handle_github_errors
def main() -> None:
    """Run the main CLI logic."""
    if len(sys.argv) > 1:
        print(f"Usage: {sys.argv[0]}", file=sys.stderr)
        sys.exit(1)

    github_lib = GitHubLib()
    repo_name = github_lib.get_github_repo_name()

    # print(f"Fetching tags and releases for {repo_name}...")
    repo = github_lib.github.get_repo(repo_name)

    tags = {tag.name for tag in repo.get_tags()}
    releases = {release.tag_name for release in repo.get_releases()}

    # missing_tags = tags - releases
    missing_tags = tags
    sorted_missing_tags = sort_versions(missing_tags)

    if not sorted_missing_tags:
        print("Nothing to do.")
        return

    print(f"Found {len(sorted_missing_tags)} missing release(s).")
    print()
    for tag_name in sorted_missing_tags:
        if tag_name in releases:
            print("Delete release:", tag_name)
            release = repo.get_release(tag_name)
            release.delete_release()

        print("Create release:", tag_name)
        repo.create_git_release(
            tag=tag_name,
            name=tag_name,
            message="",
            generate_release_notes=False,
        )


if __name__ == "__main__":
    main()
