bash_fzf() (
  # Select a file using fd and a persistent mawk or awk worker.
  # Space-separated fuzzy terms must all match, in any order. Requires Bash 4
  # or later.

  local root="${1:-.}"
  local query="" key="" sequence="" file="" encoded="" awk_command=""
  local frame="" row=""
  local -a files=() records=() matches=() awk_options=()
  local -i selected=0 offset=0 limit=12 index=0 position=0 dirty=1 match_count=0
  local worker_in worker_out worker_pid

  command -v fd &>/dev/null || return 127
  if command -v mawk &>/dev/null; then
    awk_command=mawk
    awk_options=(-W interactive)
  elif command -v awk &>/dev/null; then
    awk_command=awk
    if [[ $(command awk -W version 2>/dev/null) == *mawk* ]]; then
      awk_options=(-W interactive)
    fi
  else
    printf 'mawk or awk is required.\n' >&2
    return 127
  fi
  [[ -d "$root" ]] || return 1
  exec 3<>/dev/tty || return 1

  while IFS= read -r -d '' file; do
    files+=("$file")
    encoded="${file,,}"
    encoded="${encoded//\\/\\\\}"
    encoded="${encoded//$'\n'/\\n}"
    records+=("F$encoded")
  done < <(
    command fd --type f --hidden --exclude .git --color never --print0 -- . "$root"
  )

  ((${#files[@]})) || return 1
  coproc FZF_MATCHER {
    exec "$awk_command" "${awk_options[@]}" -v limit="$limit" '
            function decode(value, result, i, c) {
                if (!index(value, "\\")) return value
                for (i = 1; i <= length(value); i++) {
                    c = substr(value, i, 1)
                    if (c == "\\") {
                        c = substr(value, ++i, 1)
                        if (c == "n") c = "\n"
                    }
                    result = result c
                }
                return result
            }
            substr($0, 1, 1) == "F" {
                paths[total++] = decode(substr($0, 2))
                next
            }
            substr($0, 1, 1) == "Q" {
                query = decode(substr($0, 2))
                term_count = split(query, terms, /[[:space:]]+/)
                pattern_count = 0
                for (term = 1; term <= term_count; term++) {
                    if (terms[term] == "") continue
                    pattern = ""
                    for (i = 1; i <= length(terms[term]); i++) {
                        c = substr(terms[term], i, 1)
                        if (index("\\.^$[]()|*+?{}", c)) pattern = pattern "\\"
                        pattern = pattern c ".*"
                    }
                    patterns[++pattern_count] = pattern
                }
                narrow = have_query && index(query, previous) == 1
                size = narrow ? count : total
                count = 0
                for (i = 1; i <= size; i++) {
                    id = narrow ? hits[i] : i - 1
                    for (term = 1; term <= pattern_count; term++) {
                        if (paths[id] !~ patterns[term]) break
                    }
                    if (term > pattern_count) hits[++count] = id
                }
                previous = query
                have_query = 1
                next
            }
            substr($0, 1, 1) == "P" {
                offset = substr($0, 2) + 0
                print count + 0
                for (i = offset + 1; i <= count && i <= offset + limit; i++) print hits[i]
                print "."
                fflush()
            }
        '
  }
  worker_pid=$FZF_MATCHER_PID
  exec {worker_in}>&"${FZF_MATCHER[1]}"
  exec {worker_out}<&"${FZF_MATCHER[0]}"
  exec {FZF_MATCHER[1]} >&-
  exec {FZF_MATCHER[0]} <&-

  trap 'exec {worker_in}>&-; exec {worker_out}<&-; kill "$worker_pid" 2>/dev/null || :; wait "$worker_pid" 2>/dev/null || :; printf "\033[?25h\033[?1049l" >&3' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  printf '%s\n' "${records[@]}" >&"$worker_in" || return 1
  unset records
  printf '\033[?1049h\033[?25l\033[H\033[2J' >&3

  while :; do
    if ((dirty)); then
      encoded="${query,,}"
      encoded="${encoded//\\/\\\\}"
      encoded="${encoded//$'\n'/\\n}"
      printf 'Q%s\n' "$encoded" >&"$worker_in" || return 1
      selected=0
      offset=0
      dirty=0
    fi

    if ((selected < offset)); then
      offset=$selected
    elif ((selected >= offset + limit)); then
      offset=$((selected - limit + 1))
    fi

    printf 'P%d\n' "$offset" >&"$worker_in" || return 1
    IFS= read -r match_count <&"$worker_out" || return 1
    matches=()
    while IFS= read -r file <&"$worker_out"; do
      [[ "$file" == . ]] && break
      matches+=("$file")
    done
    [[ "$file" == . ]] || return 1

    printf -v frame '\033[HSearch: %s\033[K\r\n%d/%d files | Up/Down: select | Enter: accept | Esc: cancel\033[K\r\n\033[K\r\n' \
      "$query" "$match_count" "${#files[@]}"

    for ((position = 0; position < limit; position++)); do
      if ((position < ${#matches[@]})); then
        index=${matches[position]}
        if ((position + offset == selected)); then
          printf -v row '\033[7m> %q\033[0m\033[K\r\n' "${files[index]}"
        else
          printf -v row '  %q\033[K\r\n' "${files[index]}"
        fi
      else
        printf -v row '\033[K\r\n'
      fi
      frame+="$row"
    done

    printf '%s' "$frame" >&3

    key=""
    IFS= read -r -s -N 1 key <&3 || return 1

    case "$key" in
    $'\n' | $'\r')
      if ((match_count)); then
        printf '%s\n' "${files[${matches[selected - offset]}]}"
        return 0
      fi
      ;;
    $'\177' | $'\b')
      if [[ -n "$query" ]]; then
        query="${query%?}"
        dirty=1
      fi
      ;;
    $'\025')
      query=""
      dirty=1
      ;;
    $'\020')
      if ((selected > 0)); then
        selected=$((selected - 1))
      fi
      ;;
    $'\016')
      if ((selected + 1 < match_count)); then
        selected=$((selected + 1))
      fi
      ;;
    $'\003' | $'\004')
      return 130
      ;;
    $'\033')
      sequence=""
      IFS= read -r -s -N 1 -t 0.1 sequence <&3 || return 130
      if [[ "$sequence" == "[" || "$sequence" == "O" ]]; then
        key=""
        IFS= read -r -s -N 1 -t 0.1 key <&3 || continue
        case "$key" in
        A)
          if ((selected > 0)); then
            selected=$((selected - 1))
          fi
          ;;
        B)
          if ((selected + 1 < match_count)); then
            selected=$((selected + 1))
          fi
          ;;
        esac
      fi
      ;;
    *)
      if [[ "$key" == [[:print:]] ]]; then
        query+="$key"
        dirty=1
      fi
      ;;
    esac
  done
)

bash_fzf_insert_file() {
  : 'Insert the selected file path at the Readline cursor.'

  local selected="" quoted=""

  selected=$(bash_fzf .) || return 0
  printf -v quoted '%q' "$selected"

  READLINE_LINE="${READLINE_LINE:0:READLINE_POINT}${quoted} ${READLINE_LINE:READLINE_POINT}"
  READLINE_POINT=$((READLINE_POINT + ${#quoted} + 1))
}

if [[ $- == *i* ]]; then
  bind -x '"\C-t":bash_fzf_insert_file'
fi
