"""Manage GitHub repository settings.

Script to auto-detect and set the homepage URL for a GitHub repository,
and manage repository feature visibility.

Usage:
------
    python3 manage_github_repo.py

The script automatically determines the repository name and sets the
homepage URL to: https://github.com/owner/repo.
"""

import sys

from github.Repository import Repository
from github_data import IGNORE_GITHUB_REPOSITORIES
from github_lib import GitHubLib, handle_github_errors


def update_homepage_url(repo: Repository, target_url: str) -> bool:
    """Update the repository homepage URL if necessary.

    Args:
        repo: The PyGithub Repository object.
        target_url: The expected homepage URL.
    """
    if repo.homepage == target_url:
        return False

    print(f"  [UPDATE] Setting homepage to: {target_url}")
    repo.edit(homepage=target_url)
    return True


def protect_default_branch(repo: Repository) -> bool:
    """Enforce branch protection rules on the repository default branch.

    Args:
        repo: The PyGithub Repository object.
    """
    branch_name = repo.default_branch
    branch = repo.get_branch(branch_name)

    if branch.protected:
        return False

    branch.edit_protection(
        # Do not block the sole admin from pushing or bypassing checks when needed
        enforce_admins=False,
        # Enforce a clean, straight commit history without merge commits
        required_linear_history=True,
        # Prevent deleting the protected branch
        allow_deletions=False,
        # Block force pushes to protect the branch history
        allow_force_pushes=False,
        # For a solo workflow that permits direct pushes, remove the last three
        # arguments. PyGithub expects an integer when required_approving_review_count is
        # supplied. Passing False for either review option still configures the pull
        # request review rule.
        # --- The following are explicitly disabled for a solo workflow ---
        # Allow the sole contributor to merge without external approvals
        # required_approving_review_count=None,
        # Do not invalidate PRs on new commits (irrelevant without reviews)
        # dismiss_stale_reviews=False,
        # Do not mandate approval from designated CODEOWNERS
        # require_code_owner_reviews=False,
    )
    print(f"  [UPDATE] Protected branch: '{branch_name}'")
    return True


@handle_github_errors
def main() -> None:
    """Run the main CLI logic to update the repository."""
    if len(sys.argv) > 1:
        print(f"Usage: {sys.argv[0]}", file=sys.stderr)
        sys.exit(1)

    github_lib = GitHubLib()

    change = False
    index = 0
    for repo in github_lib.list_repos(ignore_repos=IGNORE_GITHUB_REPOSITORIES):
        if repo.fork:
            continue

        print(f"[REPO] {repo.full_name}")
        target_url = f"https://github.com/{repo.full_name}"

        change |= update_homepage_url(repo, target_url)

        change |= protect_default_branch(repo)

        if repo.has_wiki or repo.has_projects:
            for name, value in (
                ("Change wiki to", not repo.has_wiki),
                ("Change projects to", not repo.has_projects),
            ):
                print(f"  [UPDATE] {name}={value}")

            repo.edit(has_projects=False, has_wiki=False)
            change |= True

        if repo.delete_branch_on_merge:
            print("WARNING: delete branch")

        index += 1
        if index == 1:
            break

    if not change:
        print("Nothing to do.")


if __name__ == "__main__":
    main()
