set -euf -o pipefail

# TOTAL_CLEANUPS=0
ATIME="+30"

ATEXIT_DONE=0
FD_TMP_FILE=$(mktemp) || return 1
# shellcheck disable=SC2329
atexit() {
  local errno="$?"
  trap - INT TERM EXIT
  if [[ "$ATEXIT_DONE" -eq 0 ]]; then
    ATEXIT_DONE=1

    if [[ $FD_TMP_FILE != "" ]]; then
      [[ -f $FD_TMP_FILE ]] && rm -f "$FD_TMP_FILE"
      FD_TMP_FILE=""
    fi
  fi
  exit "$errno"
}

dir_size() {
  LC_ALL=C du -hs -- "$dir" | cut -f 1
}

cleanup_dir() {
  local dir="$1"
  if ! [[ -d "$dir" ]]; then
    return 0
  fi

  local before
  before=$(dir_size)

  find "$dir" -type f -atime "$ATIME" -delete 2>/dev/null || true

  local after
  after=$(dir_size)
  if [[ "$before" != "$after" ]]; then
    echo "[CLEANUP] $before -> $after: $dir" >&2
  fi
}

unset FD_DEFAULT_OPTIONS &>/dev/null || true
FD_OPTS=(
  --color=never
  --follow
  --exclude "/.src-other/"
  --exclude "/src/forks/"
  --exclude "/src/local/"
  --exclude "/.gnupg/"
  --exclude 'pubring.kbx~'
  --exclude '.git/'
  --exclude '.svn/'
  --exclude '.hg/'
  --exclude '/.nobackup/'
  --exclude '/.config/'
  --exclude '/.var/app/'
  --exclude '/.local/share/Trash/'
  --exclude 'user-places.xbel.bak'
  # Python
  --exclude '/.local/lib/'
  --exclude '/.config/libreoffice'
  --exclude '/.config/chromium'
  # Emacs
  --exclude "tree-sitter/"
  --exclude "autosave/"
  --exclude 'elpa/'
  --exclude 'elpaca/'
  --exclude 'straight/'
)

FD_CUSTOM_DIR="$HOME"
fd_delete() {
  local answer status
  local -a matches

  if fd --hidden --no-ignore "${FD_OPTS[@]}" "$@" \
    --print0 "$FD_CUSTOM_DIR" >"$FD_TMP_FILE"; then
    mapfile -d '' -t matches <"$FD_TMP_FILE"
  else
    return 1
  fi

  if ((${#matches[@]} == 0)); then
    return 0
  fi

  # printf 'Matched paths:\n'
  # printf '  %q\n' "${matches[@]}"

  if ! du --summarize --human-readable --total \
    --files0-from="$FD_TMP_FILE"; then
    return 1
  fi

  while true; do
    if ! read -r -p 'Delete all listed paths recursively? [yes/no] ' answer; then
      return 1
    fi

    case "$answer" in
    yes | no)
      break
      ;;
    *)
      echo "Invalid input. Please enter 'yes' or 'no'."
      ;;
    esac
  done

  case "$answer" in
  yes | YES)
    rm -rf -- "${matches[@]}"
    status=$?
    if [[ $status -eq 0 ]]; then
      printf 'Deletion done.\n\n'
    else
      printf 'Deletion error.\n\n'
    fi
    return "$status"
    ;;
  *)
    printf 'Deletion cancelled.\n\n'
    ;;
  esac
}

main() {
  trap 'atexit' INT TERM EXIT

