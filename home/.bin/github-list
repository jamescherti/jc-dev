"""Script to list all public, non-fork repositories managed."""

from github_data import IGNORE_GITHUB_REPOSITORIES
from github_lib import GitHubLib, handle_github_errors


@handle_github_errors
def main() -> None:
    """Run the main CLI logic."""
    github_lib = GitHubLib()
    for repo in github_lib.list_public_source_repos(
        ignore_repos=IGNORE_GITHUB_REPOSITORIES
    ):
        print(repo)


if __name__ == "__main__":
    main()
