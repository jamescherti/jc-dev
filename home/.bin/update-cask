"""Update Cask."""

import logging
import os
import subprocess
import sys
from pathlib import Path

VERBOSE = True
logger = logging.getLogger(__name__)


def main() -> None:
    """Start the command-line interface."""
    try:
        git_toplevel = Path(
            subprocess.check_output(
                ["git", "rev-parse", "--show-toplevel"], text=True
            ).splitlines()[0]
        )
    except subprocess.CalledProcessError:
        sys.exit(1)
    else:
        git_toplevel = Path(git_toplevel)
        if not git_toplevel.is_dir():
            logger.error("[ERROR] The directory does not exist: %s", git_toplevel)
            sys.exit(1)

        os.chdir(git_toplevel)

    if not any(git_toplevel.suffix == ".el" for git_toplevel in Path().rglob("*.el")):
        logger.info(
            "[ERROR] the following directory is not an Emacs project: %s",
            {git_toplevel},
        )
        sys.exit(1)

    subprocess.check_call(["update-cookiecutter", "addon-cask"])

    melpazoid = Path(".github/workflows/melpazoid.yml")
    if melpazoid.exists():
        melpazoid.unlink()


if __name__ == "__main__":
    main()
