"""Update cookiecutter in the current directory."""

import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

from cookiecutter.main import cookiecutter

VERBOSE = False
DEBUG = False


def first_directory(parent_dir: os.PathLike[str]) -> Path:
    """Return the first directory inside parent_dir."""
    for item in Path(parent_dir).iterdir():
        if item.is_dir():
            return item

    raise FileNotFoundError(f"There are no directories in {parent_dir}")


def main() -> None:
    """Run the command-line interface."""
    cookiecutter_template_name = sys.argv[1]

    try:
        project_dir_str = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            text=True,
        ).splitlines()[0]
    except subprocess.CalledProcessError:
        sys.exit(1)
    else:
        if VERBOSE:
            sys.stdout.write(f"[VERBOSE] Project: {project_dir_str}\n")

        project_dir = Path(project_dir_str)
        if not project_dir.is_dir():
            sys.stderr.write(f"Error: The directory does not exist: {project_dir}\n")
            sys.exit(1)

        os.chdir(project_dir)

    try:
        git_remote_origin = subprocess.check_output(
            ["git", "config", "remote.origin.url"], text=True
        ).splitlines()[0]
    except subprocess.CalledProcessError:
        sys.exit(1)
    else:
        if VERBOSE:
            sys.stdout.write(f"[VERBOSE] Remote origin: {git_remote_origin}\n")

        project_name = Path(git_remote_origin).name
        project_name = project_name.removesuffix(".git").removesuffix(".el")

        if not project_name:
            sys.stderr.write(
                "Error: The project name cannot be read from the remote origin.\n"
            )
            sys.exit(1)

        if VERBOSE:
            sys.stdout.write(f"[VERBOSE] Project name: {project_name}\n")

    # Git remote origin
    try:
        git_remote_origin = subprocess.check_output(
            ["git", "config", "remote.origin.url"], text=True
        ).splitlines()[0]
    except subprocess.CalledProcessError:
        sys.exit(1)
    else:
        if VERBOSE:
            sys.stdout.write(f"[VERBOSE] Remote origin: {git_remote_origin}\n")

    with tempfile.TemporaryDirectory() as temporary_dir:
        temp_path = Path(temporary_dir)
        if DEBUG:
            sys.stdout.write(f"[DEBUG] Temporary directory created: {temp_path}\n")

        os.chdir(temporary_dir)

        cookiecutter(
            cookiecutter_template_name,
            extra_context={"project_name": project_name},
            no_input=True,
            overwrite_if_exists=True,
            directory=".",
            skip_if_file_exists=False,
        )

        template_dir = first_directory(temp_path)
        if DEBUG:
            sys.stdout.write(f"[DEBUG] Template dir {template_dir}\n")

        shutil.copytree(template_dir, project_dir, dirs_exist_ok=True)

    sys.stdout.write(f"[SUCCESS] {project_dir}\n")


if __name__ == "__main__":
    main()
