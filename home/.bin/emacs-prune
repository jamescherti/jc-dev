set -euo pipefail

# Additional directories beyond the default ~/.*emacs*.d directories.
#
# During cleanup, the following file types are removed from these directories:
#   - .elc
#   - eln-cache/.eln
#   - var/eln-cache/.eln
#   - eln-cache/*.c
#   - var/eln-cache/*.c
# Set to an empty array to skip scanning additional directories.
ADDITIONAL_CLEANUP_DIRS=(
  "$HOME/src/emacs"
  "$HOME/src/emacs-misc"
)

# Explicitly exclude version control directories
FD_COMMON_OPTS=(
  --unrestricted
  --ignore-case
  --exclude '.git'
  --exclude '.hg'
  --exclude '.svn'
  --color=never
)

# Cache the availability of fd to avoid redundant checks inside the loop
if ! type -P fd &>/dev/null; then
  echo "Error: fd command not found." >&2
  exit 1
fi

cleanup-emacs-files() {
  local local_fd_opts=()
  if [[ ${1:-} == apply ]]; then
    local_fd_opts=(--exec-batch rm -f --)
  elif [[ ${1:-} != dry-run ]]; then
    printf "Expected dry-run or apply.\n" >&2
    exit 1
  fi

  local dir
  for dir in "${ADDITIONAL_CLEANUP_DIRS[@]}" "${PROFILE_DIRS[@]}"; do
    if ! [[ -d "$dir" ]]; then
      continue
    fi

    if [[ $1 != dry-run ]]; then
      echo "[CLEANUP] Delete *.elc files and eln-cache/* " \
        "files: $dir"
    fi

    fd "${FD_COMMON_OPTS[@]}" --type f \
      --extension elc \
      . "$dir" "${local_fd_opts[@]}"

    # delete eln-cache to remove all the .eln, .c, and .tmp files. (.c files are
    # Emacs's native compiler creates them native-comp-debug is 2 or 3, Emacs
    # writes a pseudo-C dump beside each .eln it compiles. Those dumps are only
    # useful for debugging the compiler.)
    local cache_action=()
    if [[ $1 == apply ]]; then
      cache_action=(--exec-batch rm -rf --)
    fi

    fd "${FD_COMMON_OPTS[@]}" --type d --case-sensitive --prune \
      --glob 'eln-cache' "$dir" "${cache_action[@]}"
  done
}

main() {
  local profile_opts=(--exclude '.devemacs.d')

  if [[ ${1:-} == -f ]]; then
    profile_opts=()
    shift
  fi

  if (($# > 0)); then
    printf 'Usage: %s [-f]\n' "${0##*/}" >&2
    return 2
  fi

  # Run mapfile in the current shell so it can populate PROFILE_DIRS.
  shopt -s lastpipe
  fd "${FD_COMMON_OPTS[@]}" \
    --type d \
    --max-depth 1 \
    --glob '.*emacs*.d' \
    "${profile_opts[@]}" \
    --print0 "$HOME" | mapfile -d '' -t PROFILE_DIRS

  local preview
  preview=$(
    set -e
    cleanup-emacs-files dry-run
  )

  if [[ -z "$preview" ]]; then
    echo "Nothing to do."
    return 0
  fi

  printf '%s\n\n' "$preview"
  read -r -p "Delete? [y,n] " ANSWER
  if [[ "$ANSWER" != "y" ]]; then
    exit 1
  fi
  echo

  cleanup-emacs-files apply
}

main "$@"
