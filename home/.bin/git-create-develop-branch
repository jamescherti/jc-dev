set -euo pipefail

BRANCH_NAME="develop"

# Ensure the script is run inside a git repository
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: Not a git repository." >&2
  exit 1
fi

# Detect the default branch (check for main, fallback to master)
if git rev-parse --verify refs/heads/main >/dev/null 2>&1; then
  DEFAULT_BRANCH="main"
elif git rev-parse --verify refs/heads/master >/dev/null 2>&1; then
  DEFAULT_BRANCH="master"
else
  echo "Error: Cannot find a 'main' or 'master' branch locally." >&2
  exit 1
fi

# Get the current branch
CURRENT_BRANCH=$(git branch --show-current)

# Enforce running from the default branch
if [ "$CURRENT_BRANCH" != "$DEFAULT_BRANCH" ]; then
  echo "Error: This script must be run from the default branch ($DEFAULT_BRANCH)." >&2
  echo "You are currently on '$CURRENT_BRANCH'. Please switch branches and try again." >&2
  exit 1
fi

# Check if the branch exists locally
if git rev-parse --verify "refs/heads/$BRANCH_NAME" >/dev/null 2>&1; then
  echo "Branch '$BRANCH_NAME' already exists."
else
  echo "Branch '$BRANCH_NAME' does not exist. Creating it..."

  # Create the branch
  git branch "$BRANCH_NAME"

  echo "Branch '$BRANCH_NAME' created successfully."
fi
