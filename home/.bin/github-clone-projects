"""Script to list all public, non-fork repositories and their categories."""

from pathlib import Path
from typing import cast

from github_data import CUSTOM_CATEGORIES, IGNORE_GITHUB_REPOSITORIES
from github_lib import GitHubLib, handle_github_errors
from prompt_toolkit import prompt
from prompt_toolkit.key_binding import KeyBindings, KeyPressEvent

SRC_DIR = Path().home() / "src"


def guess_category(repo_name: str) -> str:
    """
    Guess the category of a repository based on its name.

    Args:
        repo_name: The full name of the repository (e.g., owner/repo).

    Returns:
        A string representing the guessed category (e.g., "emacs", "python",
        "ansible", "unknown").
    """
    try:
        return str(CUSTOM_CATEGORIES[repo_name])
    except KeyError:
        pass

    name_lower = repo_name.lower()

    if name_lower.endswith(".el"):
        return "emacs"

    if "/jc-" in name_lower:
        return "dotfiles"

    if "ansible" in name_lower:
        return "ansible"

    if (
        "arch" in name_lower
        or "gentoo" in name_lower
        or "linux" in name_lower
        or "overlay" in name_lower
    ):
        return "linux"

    if "vim" in name_lower:
        return "vim"

    if "bash" in name_lower or "shell" in name_lower:
        return "shell"

    return "misc"


def confirm(message: str = "Continue?", *, default: bool = True) -> bool:
    """Prompt the user for a yes/no decision with a single keypress.

    Args:
        message: The prompt message to display.
        default: The fallback value when pressing Enter.

    Returns:
        True if confirmed, False otherwise.
    """
    bindings = KeyBindings()
    hint = "[Y/n]" if default else "[y/N]"
    full_prompt = f"{message} {hint} "

    @bindings.add("y")
    @bindings.add("Y")
    def _handle_yes(event: KeyPressEvent) -> None:
        event.app.exit(result=True)

    @bindings.add("n")
    @bindings.add("N")
    def _handle_no(event: KeyPressEvent) -> None:
        event.app.exit(result=False)

    @bindings.add("enter")
    def _handle_enter(event: KeyPressEvent) -> None:
        event.app.exit(result=default)

    @bindings.add("c-c")
    def _handle_cancel(event: KeyPressEvent) -> None:
        event.app.exit(exception=KeyboardInterrupt)

    return cast("bool", prompt(full_prompt, key_bindings=bindings))


@handle_github_errors
def main() -> None:
    """Run the main CLI logic."""
    github_lib = GitHubLib()

    for repo in github_lib.list_repos(ignore_repos=IGNORE_GITHUB_REPOSITORIES):
        repo_full_name = repo.full_name

        repo_name = repo.name
        category = "forks" if repo.fork else guess_category(repo_full_name)
        print(f"[PROJECT] {repo_name}")

        repo_path = SRC_DIR / category / repo_name if category else SRC_DIR / repo_name

        if repo_path.exists():
            continue

        if confirm(f"Clone '{repo_path}'?"):
            print(repo_path)


if __name__ == "__main__":
    main()
