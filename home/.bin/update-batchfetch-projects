def guess_category(repo_name: str) -> str:
    """
    Guess the category of a repository based on its name.

    Args:
        repo_name: The full name of the repository (e.g., owner/repo).

    Returns:
        A string representing the guessed category (e.g., "emacs", "python",
        "ansible", "unknown").
    """
    try:
        return str(CUSTOM_CATEGORIES[repo_name])
    except KeyError:
        pass

    name_lower = repo_name.lower()

    if name_lower.endswith(".el"):
        return "emacs"

    if "/jc-" in name_lower:
        return "dotfiles"

    if "ansible" in name_lower:
        return "ansible"

    if (
        "arch" in name_lower
        or "gentoo" in name_lower
        or "linux" in name_lower
        or "overlay" in name_lower
    ):
        return "linux"

    if "vim" in name_lower:
        return "vim"

    if "bash" in name_lower or "shell" in name_lower:
        return "shell"

    return "misc"


def generate_batchfetch_yaml(
    repos_by_category: dict[str, list[tuple[str, str, str | None]]], out_path: Path
) -> None:
    """Generate the batchfetch.yaml file with specific headers and tasks.

    Args:
        repos_by_category: Dictionary grouping repositories by their category.
            Values are tuples of (git_uri, path, upstream_url).
        out_path: Destination path for the YAML file.
    """
    lines = [
        "---",
        "# Generated automatically with update-batchfetch-projects.",
        "#",
        "# Author: James Cherti",
        "# URL: https://github.com/jamescherti/jc-dev",
        "# Copyright (C) 2004-2026 James Cherti",
        "#",
        "",
        "options:",
        '  exec_before: ["sh", "-c", "set -e; git-setup"]',
        "  git_update: false",
        '  exec_after: ["update-project-list"]',
        "  # git_update_strategy: reset",
        "  ignore_untracked:",
        "    - wip",
        "    - home-settings",
        "    - batchfetch-enc.yaml",
        "    - notes",
        "    - .ignore",
        "    - other",
        "    - .dir-settings.el",
        "    - .pathaction.yaml",
        "    - .quickaction.yaml",
        "    - local/",
        "    - bell/",
        "    - .fileaction.yaml",
        "    - batchfetch-local.yaml",
        "    - .my-dir-locals.el",
        "    - forks/.my-dir-locals.el",
        "    - emacs/.my-dir-locals.el",
        "",
        "tasks:",
    ]

    for category, repos in sorted(repos_by_category.items()):
        category_title = category.capitalize() if category else "Misc"
        lines.append(f"  # {'-' * 76}")
        lines.append(f"  # {category_title}")
        lines.append(f"  # {'-' * 76}")

        for git_uri, path_val, upstream_url in sorted(repos):
            lines.append(f"  - git: {git_uri}")
            lines.append(f"    path: {path_val}")

            if upstream_url:
                lines.append("    remote:")
                lines.append(f"      upstream: {upstream_url}")

            lines.append("")

    # Ensure trailing newline
    lines.append("")
    out_path.write_text("\n".join(lines), encoding="utf-8")


@handle_github_errors
def main() -> None:
    """Run the main CLI logic."""
    github_lib = GitHubLib()
    repos_by_category: dict[str, list[tuple[str, str, str | None]]] = (
        collections.defaultdict(list)
    )

    # Fetch and group repositories from GitHub API
    for repo in github_lib.list_repos(ignore_repos=IGNORE_GITHUB_REPOSITORIES):
        category = "forks" if repo.fork else guess_category(repo.full_name)

        upstream_url = None
        if repo.fork and getattr(repo, "parent", None):
            upstream_url = repo.parent.html_url

        git_uri = f"git@github.com:{repo.full_name}"
        repo_name = repo.full_name.split("/")[-1]
        path_val = f"{category}/{repo_name}" if category else repo_name

        repos_by_category[category].append((git_uri, path_val, upstream_url))
        print("[REPO]", repo.full_name)

    # Append missing external/custom repositories
    for repo_data in MISSING_REPOSITORIES:
        git_uri = str(repo_data["uri"])
        path_val = str(repo_data["directory"])
        upstream_url = repo_data["upstream_uri"]

        category = path_val.split("/")[0] if "/" in path_val else "misc"
        repos_by_category[category].append((git_uri, path_val, upstream_url))
        print("[MISSING REPO]", git_uri)

    # Generate YAML file
    out_path = SRC_DIR / "batchfetch.yaml"
    generate_batchfetch_yaml(repos_by_category, out_path)
    print(f"Generated {out_path}")


if __name__ == "__main__":
    main()
