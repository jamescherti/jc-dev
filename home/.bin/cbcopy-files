set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "Usage: ${0##*/} <file1> [file2 ...]" >&2
  exit 1
fi

error_handler() {
  local errno="$?"
  echo "Error: ${BASH_SOURCE[1]}:${BASH_LINENO[0]}" \
    "(${BASH_COMMAND} exited with status $errno)" >&2
  exit "$errno"
}

trap 'error_handler' ERR
set -o errtrace

print_backticks() {
  printf '``````````%s\n' "${1-}"
}

read_shebang() {
  local line=""

  [[ -f "$1" && -r "$1" ]] || return 1
  IFS= read -r line <"$1" || [[ -n "$line" ]] || return 1

  if [[ "$line" =~ ^\#\![[:space:]]*(.*)$ ]]; then
    printf '%s\n' "${BASH_REMATCH[1]%$'\r'}"
  else
    return 1
  fi
}

detect_language() {
  local shebang interpreter word

  if shebang=$(read_shebang "$1"); then
    for word in $shebang; do
      if [[ "$word" != -* && "$word" != *=* && "${word##*/}" != "env" ]]; then
        interpreter="${word##*/}"
        break
      fi
    done

    case "${interpreter-}" in
    emacs*)
      printf '%s\n' elisp
      return
      ;;
    python* | pypy*)
      printf '%s\n' python
      return
      ;;
    sh | bash | dash | ash | ksh* | mksh | zsh)
      printf '%s\n' sh
      return
      ;;
    fish | csh | tcsh)
      printf '%s\n' "${interpreter-}"
      return
      ;;
    node | nodejs | deno | bun)
      printf '%s\n' javascript
      return
      ;;
    ruby*)
      printf '%s\n' ruby
      return
      ;;
    perl*)
      printf '%s\n' perl
      return
      ;;
    php*)
      printf '%s\n' php
      return
      ;;
    lua*)
      printf '%s\n' lua
      return
      ;;
    *awk)
      printf '%s\n' awk
      return
      ;;
    Rscript)
      printf '%s\n' r
      return
      ;;
    esac
  fi

  case "${1##*/}" in
  *.el) printf '%s\n' elisp ;;
  *.py | *.pyw) printf '%s\n' python ;;
  *.sh | *.bash | *.zsh | *.ksh) printf '%s\n' sh ;;
  *.js | *.mjs | *.cjs) printf '%s\n' javascript ;;
  *.ts | *.mts | *.cts) printf '%s\n' typescript ;;
  *.rb) printf '%s\n' ruby ;;
  *.pl | *.pm) printf '%s\n' perl ;;
  *.php) printf '%s\n' php ;;
  *.lua) printf '%s\n' lua ;;
  *.json) printf '%s\n' json ;;
  *.yaml | *.yml) printf '%s\n' yaml ;;
  *.toml) printf '%s\n' toml ;;
  *.md | *.markdown) printf '%s\n' markdown ;;
  *.html | *.htm) printf '%s\n' html ;;
  *.css) printf '%s\n' css ;;
  *.xml) printf '%s\n' xml ;;
  *.c | *.h) printf '%s\n' c ;;
  *.cc | *.cpp | *.cxx | *.hpp) printf '%s\n' cpp ;;
  *.rs) printf '%s\n' rust ;;
  *.go) printf '%s\n' go ;;
  *) printf '%s\n' text ;;
  esac
}

run_markdown_ls() {
  local target_file language

  for target_file in "$@"; do
    if [[ -d "$target_file" ]]; then
      echo "Warning: skipped (not a file): $target_file" >&2
      continue
    fi

    if [[ -f "$target_file" && -r "$target_file" ]]; then
      if path-is "$target_file" binary >/dev/null 2>&1; then
        echo "Warning: skipped (binary): $target_file" >&2
        continue
      fi

      language=$(detect_language "$target_file")

      printf 'BEGIN FILE: %s\n' "$target_file"
      print_backticks "$language"
      cat -- "$target_file"

      if [[ -s "$target_file" &&
        $(tail -c 1 -- "$target_file" | wc -l) -eq 0 ]]; then
        printf '\n'
      fi

      printf '\n'
      print_backticks
      printf 'END FILE: %s\n\n' "$target_file"
    else
      echo "Error: '$target_file' is not readable." >&2
      exit 1
    fi
  done
}

run_checks() {
  local target_file

  for target_file in "$@"; do
    if [[ -d "$target_file" ]]; then
      continue
    fi

    if [[ ! -f "$target_file" || ! -r "$target_file" ]]; then
      echo "Error: '$target_file' is not a readable regular file." >&2
      exit 1
    fi
  done
}

atexit() {
  local errno="$?"
  trap - EXIT INT TERM
  rm -f -- "$TMP_FILE" || :
  exit "$errno"
}

main() {
  run_checks "$@"

  TMP_FILE=$(mktemp)
  trap 'atexit' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  run_markdown_ls "$@" >"$TMP_FILE"

  cbcopy -s -c <"$TMP_FILE" || exit 1
  cat -- "$TMP_FILE"
}

main "$@"
