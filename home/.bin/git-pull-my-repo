set -euf -o pipefail

# shellcheck disable=SC2329
error_handler() {
  local errno="$?"
  echo "Error: ${BASH_SOURCE[1]}:${BASH_LINENO[0]}" \
    "(${BASH_COMMAND} exited with status $errno)" >&2
  exit "${errno}"
}

trap "error_handler" ERR
set -o errtrace

if git remote get-url "$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null | cut -d/ -f1)" 2>/dev/null | grep -q 'jamescherti/'; then
  # Fetch new commits and prune remote-tracking branches deleted on origin.
  #
  # - git fetch origin downloads new commits and updates remote-tracking
  #   branches such as origin/main.
  # - --prune removes remote-tracking branches whose corresponding branches were
  #   deleted on origin.
  git fetch --prune origin

  # Update the local repository's record of the remote default branch
  git remote set-head origin --auto

  # Checkout to the default branch
  git checkout-default-branch

  # Merge the remote's default branch only if a fast-forward is possible.
  git merge --ff-only refs/remotes/origin/HEAD

  # Delete untracked files and directories.
  git clean -f -d

  # Stash entries are saved snapshots of changes set aside with git stash.
  # Remove all of them from this repository.
  git stash clear
fi
