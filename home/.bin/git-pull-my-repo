set -euf -o pipefail

ORIGIN=origin

# shellcheck disable=SC2329
error_handler() {
  local errno="$?"
  echo "Error: ${BASH_SOURCE[1]}:${BASH_LINENO[0]}" \
    "(${BASH_COMMAND} exited with status $errno)" >&2
  exit "${errno}"
}

trap "error_handler" ERR
set -o errtrace

delete_local_branches() {
  # We have already git fetch --prune pruned origin
  # git fetch --prune origin || exit 1
  current_branch=$(git branch --show-current)

  if ! git remote get-url origin >/dev/null 2>&1; then
    echo "Skipping branch cleanup: origin is not configured." >&2
    return
  elif ! current_branch=$(git symbolic-ref --quiet --short HEAD); then
    echo "Skipping branch cleanup: HEAD is detached." >&2
    return
  elif ! git show-ref --verify --quiet "refs/heads/$current_branch"; then
    echo "Skipping branch cleanup: current branch does not exist yet." >&2
    return
  elif ! git fetch --prune origin; then
    echo "Skipping branch cleanup: failed to fetch origin." >&2
    return
  fi

  while IFS= read -r branch; do
    # Do not delete the currently checked-out branch.
    if [[ "$branch" == "$current_branch" ]]; then
      continue
    fi

    # Delete local branches that do not exist on origin.
    if ! git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      # git branch -D -- "$branch"
      echo "delete $branch"
    fi
  done < <(git for-each-ref --format='%(refname:lstrip=2)' refs/heads)
}

main() {
  git-is-clean || exit 1

  # Update the local repository's record of the remote default branch
  ORIGIN=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null | cut -d/ -f1)

  if git remote get-url "$ORIGIN" 2>/dev/null | grep -q 'jamescherti/'; then
    git remote set-head origin --auto >/dev/null

    # Fetch new commits and prune remote-tracking branches deleted on origin.
    #
    # - git fetch origin downloads new commits and updates remote-tracking
    #   branches such as origin/main.
    # - --prune removes remote-tracking branches whose corresponding branches were
    #   deleted on origin.
    git fetch --prune origin

    # Checkout to the default branch
    git checkout-default-branch

    # Merge the remote's default branch only if a fast-forward is possible.
    git merge --ff-only refs/remotes/origin/HEAD

    # Delete untracked files and directories.
    git clean -f -d

    # Stash entries are saved snapshots of changes set aside with git stash.
    # Remove all of them from this repository.
    git stash clear

    # Delete local branches
    delete_local_branches
  fi
}

main "$@"
