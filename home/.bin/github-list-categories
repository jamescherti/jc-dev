def guess_category(repo_name: str) -> str:
    """
    Guess the category of a repository based on its name.

    Args:
        repo_name: The full name of the repository (e.g., owner/repo).

    Returns:
        A string representing the guessed category (e.g., "Emacs Lisp", "Python",
        "Ansible", "Unknown").
    """
    if repo_name in CUSTOM_CATEGORIES:
        return CUSTOM_CATEGORIES[repo_name]

    name_lower = repo_name.lower()

    if (
        "elisp" in name_lower
        or "emacs" in name_lower
        or name_lower.endswith(".el")
        or "emacs" in name_lower
    ):
        return "emacs"
    if "/jc-" in name_lower:
        return "dotfiles"

    if name_lower.endswith(".py") or "python" in name_lower:
        return "Python"

    if (
        "arch" in name_lower
        or "gentoo" in name_lower
        or "linux" in name_lower
        or "overlay" in name_lower
    ):
        return "linux"

    if "ansible" in name_lower:
        return "ansible"

    if "vim" in name_lower or "nvim" in name_lower:
        return "vim"

    if "bash" in name_lower or "shell" in name_lower:
        return "shell"

    # if "docker" in name_lower or "container" in name_lower:
    #     return "Docker"

    return "<UNKNOWN>"


@handle_github_errors
def main() -> None:
    """Run the main CLI logic."""
    github_lib = GitHubLib()

    for repo_name in github_lib.list_public_source_repos(
        ignore_repos=IGNORE_GITHUB_REPOSITORIES
    ):
        category = guess_category(repo_name)
        print(f"{repo_name:<40} {category}")


if __name__ == "__main__":
    main()
