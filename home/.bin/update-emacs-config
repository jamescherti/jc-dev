set -euf -o pipefail

LIGHTEMACS_DIR="$HOME/src/emacs-misc/lightemacs"
HOME_SETTINGS_MODULES="$HOME/src/dev/home-settings/work_cfg/home/.emacs-use-package.d/lisp/local"
EMACS_BASE_CFG="$HOME/src/dev/jc-dev/home/.emacs-use-package.d"
DELETE_ALL=false

# Arguments
if ! PARSED_OPTS=$(getopt -n "$0" -o f -- "$@"); then
  echo "Usage: $0 [-f]" >&2
  exit 1
fi
eval set -- "$PARSED_OPTS"

while true; do
  case "$1" in
  -f)
    DELETE_ALL=true
    shift
    ;;
  --)
    shift
    break
    ;;
  *)
    echo "Unexpected error parsing arguments" >&2
    exit 1
    ;;
  esac
done

run-rsync() {
  echo "[RSYNC]" "$@"
  rsync -a \
    --times --atimes --exclude '*.elc' --exclude '*.eln' \
    --exclude legacy \
    "$@"
  return 0
}

# shellcheck disable=SC2317
error_handler() {
  local errno="$?"
  echo "Error: ${BASH_SOURCE[1]}:${BASH_LINENO[0]}" \
    "(${BASH_COMMAND} exited with status $errno)" >&2
  exit "${errno}"
}

init() {
  trap "error_handler" ERR
  set -o errtrace

  if [[ -z ${DEST_DIR:-} ]]; then
    DEST_DIR="$HOME"
  fi

  if ! [[ -d "$LIGHTEMACS_DIR" ]]; then
    echo "Error: The directory doesn't exist: $LIGHTEMACS_DIR" >&2
    exit 1
  fi

  git -C "$LIGHTEMACS_DIR" checkout --quiet develop
}

lightemacs-init-files() {
  local dest_dir="$1"

  mkdir -p "$dest_dir/lisp/lightemacs"

  run-rsync "$LIGHTEMACS_DIR/early-init.el" \
    "$LIGHTEMACS_DIR/init.el" \
    "$dest_dir/"

  run-rsync --delete "$LIGHTEMACS_DIR/lisp/lightemacs/" \
    "$dest_dir/lisp/lightemacs/"
}

custom-emacs() {
  local custom_emacs_name="$1"
  local dest_dir="$DEST_DIR/.${custom_emacs_name}.d"

  echo
  echo "[CUSTOM-EMACS] ${custom_emacs_name}"

  if [[ $DELETE_ALL = true ]]; then
    rm -fr "$dest_dir/lisp"
  fi

  # Lightemacs config
  lightemacs-init-files "$dest_dir"

  # Local config
  mkdir -p "$dest_dir/lisp/local"
  run-rsync \
    --delete \
    "$EMACS_BASE_CFG/lisp/local/config.el" \
    "$EMACS_BASE_CFG/lisp/local/" \
    "$HOME_SETTINGS_MODULES/" \
    "$dest_dir/lisp/local/"

  shift
}

# ------------------------------------------------------------------------------
# INIT
# ------------------------------------------------------------------------------
init

# ------------------------------------------------------------------------------
# My Emacs: EMACS MASTER
# ------------------------------------------------------------------------------
custom-emacs "emacs-use-package" &
custom-emacs "emacs-master" &
custom-emacs "emacs-elpaca" &
custom-emacs "emacs-straight" &
# custom-emacs "emacs-local"

# ------------------------------------------------------------------------------
# OTHER LIGHTEMACS
# ------------------------------------------------------------------------------
if [[ "$DELETE_ALL" == true ]] || ! [[ -d "$DEST_DIR/.devemacs.d" ]]; then
  # Only when it does not exist. This is supposed to always be stable.
  lightemacs-init-files "$DEST_DIR/.devemacs.d"
  mkdir -p "$DEST_DIR/.devemacs.d/lisp/local"
  run-rsync \
    "$HOME/src/dev/jc-dev/home/.devemacs.d/lisp/local/config.el" \
    "$DEST_DIR/.devemacs.d/lisp/local/config.el"
fi

lightemacs-init-files "$DEST_DIR/.lightemacs-straight.d" &
lightemacs-init-files "$DEST_DIR/.lightemacs-elpaca.d" &

wait

