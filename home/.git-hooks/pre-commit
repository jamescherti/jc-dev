set -euf -o pipefail
IFS=$'\n\t'
echo "[HOOK] pre-commit"

AUTHORINFO=$(git var GIT_AUTHOR_IDENT)
echo "[INFO] Author: $AUTHORINFO"

declare -A GIT_CONFIG=()

load_git_config() {
  local line key
  while IFS= read -r line; do
    if [[ $line == *=* ]]; then
      key="${line%%=*}"
      GIT_CONFIG["${key,,}"]="${line#*=}"
    fi
  done < <(git config --list 2>/dev/null || true)
}

#-------------------------------------------------------------------------------
# Error handler
#-------------------------------------------------------------------------------
# shellcheck disable=SC2317
error_handler() {
  local errno="$?"
  echo "Error: ${BASH_SOURCE[1]}:${BASH_LINENO[0]}" \
    "(${BASH_COMMAND} exited with status $errno)" >&2
  exit "${errno}"
}

check_email_change() {
  if type -P git-setup &>/dev/null && ! git-setup; then
    echo
    echo "WARNING: The commit has been canceled because the name / email" \
      "has been changed. Please commit again." >&2
    exit 1
  fi
}

error() {
  echo "$@" >&2
}

init() {
  load_git_config

  local git_username="${GIT_CONFIG[user.name]:-}"

  if [[ $git_username != *" "* ]]; then
    error "[ERROR] Your GIT username '$git_username' is incomplete. " \
      "It needs to contain 'firstname lastname' (separated by a space)."
    echo
    error "Please put your firstname and lastname with this command:"
    error "--------------------------------------------------------------------"
    error "    git config --global user.name 'Firstname Lastname'"
    error "--------------------------------------------------------------------"
    echo
    exit 1
  fi

  if git rev-parse --verify HEAD &>/dev/null; then
    AGAINST=HEAD
  else
    # Initial commit: diff against an empty tree object
    AGAINST=4b825dc642cb6eb9a060e54bf8d69288fbee4904
  fi

  # Redirect output to stderr.
  # exec 1>&2

  # I use INSTALL_HOOKS_GITROOT to update the symbolic links
  # (from absolute to relative: it is better for people who move
  #  their directory locally)
  if [[ -d .git ]]; then
    INSTALL_HOOKS_GITROOT="$PWD"
  else
    INSTALL_HOOKS_GITROOT="$(git rev-parse --show-toplevel)"
    if ! [[ -d "$INSTALL_HOOKS_GITROOT/.git" ]]; then
      echo "Error: the script $0 is not in a GIT directory: $PWD"
      exit 1
    else
      cd "$INSTALL_HOOKS_GITROOT" || exit 1
    fi
  fi

  INIT_SUCCESS=1
}

check_gpg() {
  #
  # Check the GPG configuration
  #
  local gpgerror=0
  local gpgsign="${GIT_CONFIG[commit.gpgsign]:-}" # needs to be: true

  if [[ "${gpgsign,,}" != "true" ]]; then
    error "ERROR: you need to activate GPG signature with:" \
      "git config commit.gpgsign true"
    gpgerror=1
  fi

  local gpgkey="${GIT_CONFIG[user.signingkey]:-}"
  if [[ -z "${gpgkey}" ]]; then
    error "ERROR: you need to specify your GPG key with:" \
      "git config user.signingkey <GPG-KEY-ID>"
    gpgerror=1
  fi

  if [[ "$gpgerror" -eq 1 ]]; then
    echo "[WARNING] You need to configure your GIT with GPG."
    exit 0
  fi
}

update_list_files() {
  MODIFIED_FILES=()
  DELETED_FILES=()

  # A=added C=Copied M=Modified R=Renamed
  local status file
  while IFS=$'\t' read -r status file; do
    case "$status" in
    D*)
      DELETED_FILES+=("$file")
      ;;
    A* | C* | M* | R*)
      if ! [[ -e "$file" ]]; then
        echo "[IGNORED] $file"
        continue
      fi
      MODIFIED_FILES+=("$file")
      ;;
    esac
  done < <(git diff-index --cached --name-status "$AGAINST" || true)
}

check_non_ascii() {
  # If you want to allow non-ASCII filenames set this variable to true.
  # allownonascii=$(git config --bool hooks.allownonascii)
  local allownonascii
  allownonascii=false

  # Cross platform projects tend to avoid non-ASCII filenames; prevent
  # them from being added to the repository. We exploit the fact that the
  # printable range starts at the space character and ends with tilde.
  if [[ "$allownonascii" != "true" ]]; then
    local result=''
    result=$(git diff --cached --name-only --diff-filter=A \
      -z "$AGAINST" | LC_ALL=C tr -d '[ -~]\0' | wc -c)
    if [[ "$result" -ne 0 ]]; then
      error "------------------------------------------------------------------"
      echo "[ERROR] Attempt to add a non-ASCII file name:"
      git diff --cached --name-only --diff-filter=A -z "$AGAINST" | LC_ALL=C cat

      echo
      echo
      echo "[ERROR] non-ASCII file names can cause problems because we work "
      echo "        with people who use different operating systems. To be "
      echo "        portable, would you please rename the non-ASCII file name "
      echo "        to an valid ASCII name with:"
      echo "        git mv nonasciifile validfilename"
      echo
      error "------------------------------------------------------------------"
      exit 1
    fi
  fi
}

check_forbidden_characters() {
  local file
  local fault=0
  for file in "${MODIFIED_FILES[@]}"; do
    echo "Check modified file: $file"
    # Extract only the added lines in the staged changes and grep for
    # typographic quotes using proper locale settings for UTF-8
    if git diff --no-ext-diff --cached -- "$file" \
      | grep -E '^\+([^+]|$)' | grep -q -E "’|‘|—"; then
      error "[ERROR] Forbidden characters ('’', '‘', —...) introduced in: $file"
      fault=1
    fi
  done
  if [[ "$fault" -eq 1 ]]; then
    exit 1
  fi
}

check_syntax() {
  # SYNTAX CHECK
  echo
  echo "[CHECK] Checking the Syntax"
  local file
  for file in "${MODIFIED_FILES[@]}"; do
    "$MISCDIR/check_syntax.sh" "$file" "$PWD"
  done
}

check_pre_commit() {
  # Short-circuit: only run if the config file exists
  if [[ ! -f "$INSTALL_HOOKS_GITROOT/.pre-commit-config.yaml" ]]; then
    echo "[IGNORE] pre-commit (Missing: .pre-commit-config.yaml)"
    return 0
  fi

  local repo_path
  repo_path="$(realpath -m "$INSTALL_HOOKS_GITROOT")"

  local src_dir
  src_dir="$(realpath -m "$HOME/src")"

  # 1. Require the repository to be inside ~/src
  if [[ "$repo_path" != "$src_dir" && "$repo_path" != "$src_dir"/* ]]; then
    echo "[IGNORE] pre-commit (Path '$repo_path' is outside '$src_dir')"
    return 0
  fi

  # 2. Block the repository if it is inside ~/src/forks
  if [[ "$repo_path" == "$src_dir/forks" || "$repo_path" == "$src_dir/forks"/* ]]; then
    echo "[IGNORE] pre-commit (Excluded directory: forks)"
    return 0
  fi

  # 3. Block the repository if it is inside ~/src/local
  if [[ "$repo_path" == "$src_dir/local" || "$repo_path" == "$src_dir/local"/* ]]; then
    echo "[IGNORE] pre-commit (Excluded directory: local)"
    return 0
  fi

  # Skip if git-crypt is handling the filter
  if [[ -f .gitattributes ]] && [[ $(<.gitattributes) == *"filter=git-crypt"* ]]; then
    echo "[IGNORE] pre-commit (git-crypt)"
    return 0
  fi

  # File generated by pre-commit: https://pre-commit.com
  local pre_commit_bin
  if pre_commit_bin=$(type -P pre-commit); then
    INSTALL_PYTHON=/usr/bin/python3
    ARGS=(hook-impl --config=.pre-commit-config.yaml --hook-type=pre-commit)
    local script_dir="${0%/*}"
    [[ $script_dir != "$0" ]] || script_dir="."
    HERE="$(cd "$script_dir" && pwd)"
    ARGS+=(--hook-dir "$HERE" -- "$@")

    if [[ -x "$INSTALL_PYTHON" ]]; then
      exec "$INSTALL_PYTHON" -mpre_commit "${ARGS[@]}"
    elif [[ -n "$pre_commit_bin" ]]; then
      exec "$pre_commit_bin" "${ARGS[@]}"
    else
      echo 'Error: pre-commit not found.' 1>&2
      exit 1
    fi
  fi
}

check_arch_linux() {
  # TODO: Use a temporary file
  if [[ -f PKGBUILD ]]; then
    if ! [[ -f .SRCINFO ]] || [[ PKGBUILD -nt .SRCINFO ]]; then
      echo "[INFO] Update .SRCINFO"
      makepkg --printsrcinfo >.SRCINFO
      local srcinfo_status
      srcinfo_status=$(git status --porcelain .SRCINFO)
      if [[ $srcinfo_status == [[:space:]M]* ]]; then
        makepkg --verifysource -f
        echo "[FAILED] The .SRCINFO file has been updated successfully." \
          "Please commit again."
        exit 1
      fi
    fi

    makepkg --verifysource -f
  fi
}

main() {
  trap "error_handler" ERR
  set -o errtrace

  echo "[INFO] client side pre-commit hook started"
  init
  [[ "$INIT_SUCCESS" -ne 1 ]] && {
    error "You need to run init() before main()"
    exit 1
  }

  # Get the current branch name
  CURRENT_BRANCH=$(git branch --show-current)
  DEFAULT_BRANCH=$(git-default-branch)

  # Check if the current branch is main or master
  if [[ "$CURRENT_BRANCH" = "$DEFAULT_BRANCH" ]]; then
    echo "Error: Direct commits to the '$CURRENT_BRANCH' branch are " \
      "forbidden. Please use another branch." >&2
    exit 1
  fi

  # Update the list of files
  update_list_files

  # Checks
  check_email_change "$@"
  check_gpg
  check_non_ascii

  if [[ "${FORBIDDEN_CHARACTERS:-}" = "" ]] \
    || [[ "${FORBIDDEN_CHARACTERS:-}" -eq 0 ]]; then
    check_forbidden_characters
  fi
  # check_syntax

  check_arch_linux
  # check_pre_commit "$@"
}

# Main
main "$@"
